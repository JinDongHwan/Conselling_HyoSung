# .env.local 로 복사한 뒤 값을 채우세요 (.env.local은 git에 올리지 않음)

# ── AI 제공자 (둘 중 하나) ──
# 1) Open AI Service Hub (open.hasa.re.kr) — 있으면 이쪽을 우선 사용
HASA_API_KEY=
# HASA_BASE_URL=https://open.hasa.re.kr/v1
# 2) OpenAI
OPENAI_API_KEY=

# 선택: 모델 변경 (기본값 — hasa: exaone-4.0-32b / gpt-oss-20b / bge-m3, openai: gpt-5.5 / gpt-5.4-mini / text-embedding-3-small)
# AI_CHAT_MODEL=
# AI_UTILITY_MODEL=
# AI_EMBEDDING_MODEL=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 키는 Supabase 대시보드 > Authentication > Providers > Kakao 에 입력
